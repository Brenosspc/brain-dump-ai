# --- IA (obrigatório) ---
# Gere grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelos (opcional). Deixe GEMINI_MODELO_RESERVA vazio para desligar o reserva.
GEMINI_MODELO=
GEMINI_MODELO_RESERVA=

# --- Banco de dados (opcional) ---
# Sem DATABASE_URL, o histórico fica só no navegador.
DATABASE_URL=
# Caminho do certificado raiz do banco (padrão: certs/supabase-ca.crt)
DATABASE_CA_PATH=

# --- Login com Supabase Auth (opcional) ---
# Project URL e chave anon/publishable (pública). Nunca use a service_role/secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Servidor (opcional) ---
PORT=3000
# Use 1 ao hospedar atrás de um proxy (Render, Railway etc.)
TRUST_PROXY=
