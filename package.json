{
  "name": "brain-dump-ai",
  "version": "1.0.0",
  "description": "Brain dump para TDAH/ansiedade: escreva pensamentos sem ordem e a IA (Gemini) organiza em categorias.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.css -o public/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.css -o public/tailwind.css --watch",
    "test": "node --test",
    "db:setup": "node scripts/configurar-banco.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "brain-dump",
    "tdah",
    "ansiedade",
    "gemini",
    "express"
  ],
  "author": "Breno Cardoso",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
